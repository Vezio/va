# Copy outside the repository, chmod 600, fill only what you use (KEY=value, no quotes), then:
#   kubectl -n <namespace> create secret generic app-secrets --from-env-file=<path> \
#     --dry-run=client -o yaml | kubectl -n <namespace> apply -f -
#
# Notifier URLs are credentials: keep them here and point a notifier spec at them, e.g.
# HTTPCHECK_NOTIFY=slack:env:SLACK_WEBHOOK,webhook:env:ALERTS_WEBHOOK in app-settings.
SLACK_WEBHOOK=
ALERTS_WEBHOOK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SERVICE_URL=
