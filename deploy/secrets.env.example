# Copy this file outside the repository, set its mode to 600, and fill in the values in use
# (KEY=value, without quotes). Then create the secret:
#   kubectl -n <namespace> create secret generic app-secrets --from-env-file=<path> \
#     --dry-run=client -o yaml | kubectl -n <namespace> apply -f -
#
# Notifier URLs are credentials. Store them here and reference them from a notifier spec, e.g.
# HTTPCHECK_NOTIFY=slack:env:SLACK_WEBHOOK,webhook:env:ALERTS_WEBHOOK in app-settings.
SLACK_WEBHOOK=
ALERTS_WEBHOOK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SERVICE_URL=
