# Runner image for unattended operation: the example tool and its extras, running `<app> job`.
# Build from the repository root:
#   podman build -f container/Containerfile --build-arg GIT_SHA="$(git rev-parse HEAD)" -t <registry>/<org>/httpcheck:<sha> .
FROM python:3.12-slim
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HOME=/tmp
WORKDIR /src
# Third-party dependencies are installed from the lock file (scripts/lock.sh) with hash
# checking, which keeps rebuilds reproducible and rejects modified packages.
COPY container/requirements.lock ./
RUN pip install --require-hashes -r requirements.lock
# Install va and the tool from source; their dependencies are already installed.
COPY pyproject.toml README.md ./
COPY src ./src
COPY examples/httpcheck ./examples/httpcheck
RUN pip install --no-deps . ./examples/httpcheck && pip check && rm -rf /src
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["httpcheck"]
CMD ["job"]
